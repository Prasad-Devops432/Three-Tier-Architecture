# Copy this to .env and fill in your real values. Never commit the real .env file.

# MongoDB Atlas connection string (from Atlas > Connect > Drivers)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/devops3tier?retryWrites=true&w=majority

# Any long random string — used to sign JWTs
JWT_SECRET=replace_with_a_long_random_string

PORT=5000
